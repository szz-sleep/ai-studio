#!/bin/bash

# ==================================================
# OPC Studio - macOS 启动文件
# 双击即可启动，自动在浏览器中打开
# ==================================================

# 切换到脚本所在目录
cd "$(dirname "$0")"

echo ""
echo "╔═══════════════════════════════════════════╗"
echo "║         🚀 OPC Studio 启动中...           ║"
echo "╠═══════════════════════════════════════════╣"
echo "║                                           ║"
echo "║  🌐 请打开浏览器访问：                    ║"
echo "║     http://localhost:8080                  ║"
echo "║                                           ║"
echo "║  ⏹  按 Ctrl+C 停止服务                    ║"
echo "║                                           ║"
echo "╚═══════════════════════════════════════════╝"
echo ""

# 尝试自动打开浏览器
sleep 1
open http://localhost:8080 2>/dev/null || echo "（已尝试自动打开浏览器，如未成功请手动输入地址）"

# 启动 HTTP 服务
python3 -m http.server 8080
