{
  "name": "ai-studio",
  "version": "1.0.15",
  "description": "AI Studio - AI\u521b\u4f5c\u5de5\u574a",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "build:mac": "electron-builder --mac --x64 --publish=never",
    "build:win": "electron-builder --win --x64 --publish=never",
    "build:all": "electron-builder --mac --win --x64 --publish=never"
  },
  "author": "\u6e56\u5317\u751f\u800c\u4e3a\u4e00\u79d1\u6280\u6709\u9650\u516c\u53f8",
  "license": "MIT",
  "devDependencies": {
    "electron": "^33.4.11",
    "electron-builder": "^25.0.0",
    "electron-packager": "^17.0.0"
  },
  "build": {
    "appId": "com.zhrccp.aistudio",
    "productName": "AI Studio",
    "executableName": "AIStudio",
    "directories": {
      "output": "dist"
    },
    "files": [
      "main.js",
      "preload.js",
      "index.html",
      "css/**/*",
      "js/**/*",
      "assets/**/*",
      "models.json",
      "package.json"
    ],
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "assets/icon.icns",
      "category": "public.app-category.productivity",
      "artifactName": "AI-Studio-${version}-${arch}.${ext}"
    },
    "dmg": {
      "title": "AI Studio",
      "contents": [
        {
          "x": 130,
          "y": 220
        },
        {
          "x": 410,
          "y": 220,
          "type": "link",
          "path": "/Applications"
        }
      ]
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "assets/icon.png"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "AI Studio",
      "installerIcon": "assets/icon.ico",
      "uninstallerIcon": "assets/icon.ico",
      "installerHeaderIcon": "assets/icon.ico",
      "license": "LICENSE.txt"
    }
  }
}