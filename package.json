{
  "name": "ai-studio",
  "version": "1.0.22",
  "description": "AI Studio - AI创作工坊",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "test": "node --test test/*.test.js",
    "build:mac": "electron-builder --mac --x64 --publish=never",
    "build:win": "electron-builder --win --x64 --publish=never",
    "build:all": "electron-builder --mac --win --x64 --publish=never"
  },
  "author": "湖北生而为一科技有限公司",
  "license": "MIT",
  "devDependencies": {
    "electron": "^33.4.11",
    "electron-builder": "^25.0.0",
    "electron-packager": "^17.0.0"
  },
  "build": {
    "appId": "com.zhrccp.aistudio",
    "productName": "AI Studio",
    "executableName": "AIStudio",
    "directories": {
      "output": "dist"
    },
    "files": [
      "main.js",
      "preload.js",
      "index.html",
      "css/**/*",
      "js/**/*",
      "assets/**/*",
      "models.json",
      "package.json",
      "node_modules/@ffmpeg-installer/**/*",
      "!history/**",
      "!.workbuddy/**",
      "!README.md",
      "!clear.html"
    ],
    "asarUnpack": [
      "node_modules/@ffmpeg-installer/**/*"
    ],
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "assets/icon.icns",
      "category": "public.app-category.productivity",
      "artifactName": "AI-Studio-${version}-${arch}.${ext}",
      "files": [
        "!node_modules/@ffmpeg-installer/win32-x64/**",
        "!node_modules/@ffmpeg-installer/linux-x64/**"
      ]
    },
    "dmg": {
      "title": "AI Studio",
      "contents": [
        {
          "x": 130,
          "y": 220
        },
        {
          "x": 410,
          "y": 220,
          "type": "link",
          "path": "/Applications"
        }
      ]
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "assets/icon.ico",
      "files": [
        "!node_modules/@ffmpeg-installer/darwin-x64/**",
        "!node_modules/@ffmpeg-installer/linux-x64/**"
      ]
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "AI Studio",
      "installerIcon": "assets/icon.ico",
      "uninstallerIcon": "assets/icon.ico",
      "installerHeaderIcon": "assets/icon.ico",
      "license": "LICENSE.txt",
      "unicode": true
    }
  },
  "optionalDependencies": {
    "@ffmpeg-installer/darwin-x64": "^4.1.0",
    "@ffmpeg-installer/win32-x64": "^4.1.0"
  }
}
